{
  "name": "@mintlayer/entropy-generator",
  "version": "1.0.7",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/entropy-generator.js",
  "module": "./dist/entropy-generator.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint lib/**/*.js",
    "prettier": "prettier --check lib",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "crypto-shuffle": "^1.0.1",
    "get-random-values": "^4.1.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "prettier": "^3.8.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "eslint": "^9.39.2"
  },
  "exports": {
    ".": {
      "import": "./dist/entropy-generator.js",
      "require": "./dist/entropy-generator.umd.cjs"
    },
    "./package.json": "./package.json"
  },
  "bugs": {
    "url": "https://github.com/mintlayer/entropy-generator/issues"
  },
  "repository": {
    "type": "url",
    "url": "https://github.com/mintlayer/entropy-generator"
  },
  "engines": {"node": ">=14.21.3", "npm": ">=6.14.18"},
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": ["entropy", "generator", "permutation"],
  "license":"MIT"
}
